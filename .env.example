# Domínio próprio via Cloudflare Tunnel (docker compose --profile site up -d)
TUNNEL_TOKEN=

# Copie para .env e preencha UMA das opções de TURN.
# Sem TURN, chamadas entre redes diferentes (ex.: Wi-Fi x 4G) não conectam.

# Opção 1 (recomendada): Cloudflare TURN
# Painel Cloudflare > Realtime > TURN Server > Create -> copie o Key ID e o API Token
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Opção 2: coturn próprio (docker compose --profile turn up) em uma máquina com IP público
# TURN_URLS=turn:SEU_IP_PUBLICO:3478?transport=udp,turn:SEU_IP_PUBLICO:3478?transport=tcp
# TURN_SECRET=um-segredo-longo-e-aleatorio
# TURN_EXTERNAL_IP=SEU_IP_PUBLICO

# Opção 3: provedor com usuário/senha fixos (ex.: Metered, Twilio)
# TURN_URLS=turn:exemplo.com:3478,turns:exemplo.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
