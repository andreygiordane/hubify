import React, { useState, useEffect, useMemo } from 'react';
import {
    Mic, MicOff, Video, VideoOff, PhoneOff,
    Users, MessageSquare, Hand, UserPlus,
    MoreVertical, X, ShieldCheck, SignalHigh,
    ChevronUp, Grid as GridIcon, ScreenShare,
    ZoomIn, RotateCcw, Monitor, Settings, Layout
} from 'lucide-react';
import { motion, AnimatePresence, useMotionValue } from 'framer-motion';

const App = () => {
    // --- ESTADOS DE INTERFACE ---
    const [isMuted, setIsMuted] = useState(false);
    const [isVideoOn, setIsVideoOn] = useState(true);
    const [showSidePanel, setShowSidePanel] = useState(false);
    const [handRaised, setHandRaised] = useState(false);
    const [isReceivingShare, setIsReceivingShare] = useState(false);
    const [isMobile, setIsMobile] = useState(false);

    // --- ESTADO DE ZOOM/PAN (CONTEÚDO COMPARTILHADO) ---
    const [scale, setScale] = useState(1);
    const x = useMotionValue(0);
    const y = useMotionValue(0);

    // --- DETECÇÃO DE DISPOSITIVO ---
    useEffect(() => {
        const checkMobile = () => setIsMobile(window.innerWidth < 768);
        checkMobile();
        window.addEventListener('resize', checkMobile);
        return () => window.removeEventListener('resize', checkMobile);
    }, []);

    // --- PARTICIPANTES MOCK ---
    const participants = useMemo(() => [
        { id: 1, name: "akazure", isSpeaking: true, isMuted: false, avatar: "👤" },
        { id: 2, name: "Bruno Costa", isSpeaking: false, isMuted: true, avatar: "👨‍💻" },
        { id: 3, name: "Carla Dias", isSpeaking: false, isMuted: false, avatar: "👩‍🔬" },
        { id: 4, name: "Diego Silva", isSpeaking: false, isMuted: false, avatar: "👨‍🎨" },
        { id: 5, name: "Elena Luz", isSpeaking: false, isMuted: true, avatar: "👩‍💼" },
        { id: 6, name: "Fabio M.", isSpeaking: false, isMuted: false, avatar: "👨‍🔧" },
    ], []);

    // --- SIMULAÇÃO DE ÁUDIO ---
    const [audioLevel, setAudioLevel] = useState(5);
    useEffect(() => {
        const interval = setInterval(() => {
            setAudioLevel(Math.floor(Math.random() * 10) + 2);
        }, 400);
        return () => clearInterval(interval);
    }, []);

    const resetView = () => {
        setScale(1);
        x.set(0);
        y.set(0);
    };

    return (
        <div className="flex flex-col bg-black text-white h-screen w-full relative overflow-hidden font-sans selection:bg-blue-500/30">

            {/* 1. HEADER (ESTILO CÁPSULA ARREDONDADA) */}
            <header className={`shrink-0 z-50 flex justify-between items-center bg-black transition-all ${isMobile ? 'h-20 px-4' : 'h-24 px-8'}`}>
                <div className="flex items-center gap-3 bg-zinc-900/60 backdrop-blur-xl border border-white/5 p-2 rounded-2xl shadow-xl">
                    <div className="bg-blue-600 px-2.5 py-1 rounded-lg font-black italic text-[10px] shadow-lg shadow-blue-600/30">HUBIFY</div>
                    <div className="h-4 w-px bg-white/10" />
                    <div className="flex flex-col">
                        <h1 className={`${isMobile ? 'text-[10px]' : 'text-xs'} font-bold uppercase tracking-widest text-white/90 truncate max-w-[120px] sm:max-w-none`}>
                            {isMobile ? 'Daily Scrum' : 'Sprint Planning - Mobile Team'}
                        </h1>
                        <div className="flex items-center gap-1.5 opacity-40">
                            <ShieldCheck size={isMobile ? 10 : 12} className="text-blue-400" />
                            <span className="text-[9px] font-mono tracking-tighter">CRIPTOGRAFIA ATIVA</span>
                        </div>
                    </div>
                </div>

                <div className="flex items-center gap-3">
                    {!isMobile && (
                        <div className="bg-zinc-900/60 backdrop-blur-xl border border-white/5 px-4 py-2 rounded-2xl flex items-center gap-4">
                            <div className="flex -space-x-2">
                                {participants.slice(0, 3).map(p => (
                                    <div key={p.id} className="w-6 h-6 rounded-full border-2 border-zinc-950 bg-zinc-800 flex items-center justify-center text-[10px]">{p.avatar}</div>
                                ))}
                            </div>
                            <span className="text-[10px] font-bold opacity-40 uppercase tracking-widest">00:45:12</span>
                        </div>
                    )}
                    <button className="p-2.5 bg-zinc-900/60 backdrop-blur-xl rounded-full border border-white/5 hover:bg-white/5 transition-colors">
                        <MoreVertical size={isMobile ? 18 : 20} />
                    </button>
                </div>
            </header>

            {/* 2. ÁREA PRINCIPAL (GRID + COMPARTILHAMENTO) */}
            <main className="flex-1 flex overflow-hidden">

                <div className="relative flex-1 h-full bg-[#050505] overflow-hidden flex flex-col">

                    {isReceivingShare ? (
                        /* --- MODO COMPARTILHAMENTO --- */
                        <div className={`flex h-full w-full ${isMobile ? 'flex-col' : 'flex-row'}`}>
                            <div className="flex-1 flex flex-col justify-center bg-black relative overflow-hidden">
                                {!isMobile && (
                                    <div className="absolute top-6 left-8 z-20 flex items-center gap-3 bg-black/40 backdrop-blur-md px-4 py-2 rounded-full border border-white/10">
                                        <Monitor size={14} className="text-blue-400" />
                                        <span className="text-[10px] font-bold uppercase tracking-widest opacity-60">Bruno Costa está apresentando</span>
                                    </div>
                                )}

                                <motion.div
                                    drag={scale > 1}
                                    style={{ x, y, scale }}
                                    className={`w-full aspect-video bg-[#0a0a0a] border-y border-white/5 flex flex-col overflow-hidden touch-none transition-shadow ${scale > 1 ? 'shadow-2xl z-10' : ''}`}
                                >
                                    <div className="flex-1 p-12 font-mono text-xs sm:text-sm leading-relaxed space-y-2 opacity-70">
                                        <p className="text-blue-400">class <span className="text-yellow-400">HybridInterface</span> {"{"}</p>
                                        <p className="pl-6 text-green-400">constructor() {"{"}</p>
                                        <p className="pl-12 text-white/50">// Este layout funciona em Web e Mobile.</p>
                                        <p className="pl-12 text-white/50">// As telas de vídeo usam bordas retas e gap zero.</p>
                                        <p className="pl-12 text-white/50">// O menu e o cabeçalho são arredondados.</p>
                                        <p className="pl-6 text-green-400">{"}"}</p>
                                        <p className="text-blue-400">{"}"}</p>
                                    </div>
                                </motion.div>

                                {/* ZOOM CONTROLS */}
                                <div className="absolute bottom-6 right-6 flex gap-2">
                                    <button onClick={() => setScale(s => Math.min(s + 0.5, 3))} className="p-3.5 bg-zinc-900/80 border border-white/10 rounded-xl hover:bg-zinc-800 transition-colors shadow-2xl">
                                        <ZoomIn size={20} />
                                    </button>
                                    {scale > 1 && <button onClick={resetView} className="p-3.5 bg-blue-600 rounded-xl text-white shadow-lg"><RotateCcw size={20} /></button>}
                                </div>
                            </div>

                            {/* FILMSTRIP (PARTICIPANTES LATERAIS NO WEB / HORIZONTAIS NO MOBILE) */}
                            <div className={`${isMobile ? 'h-24 w-full flex-row border-t' : 'w-72 h-full flex-col border-l'} bg-black border-white/5 flex overflow-auto no-scrollbar shrink-0`}>
                                {participants.map((p) => (
                                    <div key={p.id} className={`${isMobile ? 'w-24 h-full border-r' : 'w-full aspect-video border-b'} bg-[#0a0a0a] border-white/5 flex items-center justify-center relative shrink-0`}>
                                        <span className={`${isMobile ? 'text-2xl' : 'text-4xl'} opacity-5`}>{p.avatar}</span>
                                        <div className="absolute bottom-2 left-2 bg-black/60 px-2 py-0.5 rounded text-[8px] font-bold uppercase tracking-widest truncate max-w-[80%]">{p.name}</div>
                                        {p.isSpeaking && <div className="absolute inset-0 border-2 border-blue-500/40 pointer-events-none" />}
                                    </div>
                                ))}
                            </div>
                        </div>
                    ) : (
                        /* --- MODO GRID (BORDAS RETAS E GAP ZERO) --- */
                        <div className={`grid ${isMobile ? 'grid-cols-2' : 'grid-cols-2 lg:grid-cols-3'} gap-0 h-full w-full`}>
                            {participants.map((p) => (
                                <div
                                    key={p.id}
                                    className={`relative bg-[#080808] border-[0.5px] border-white/5 flex items-center justify-center overflow-hidden group transition-all duration-300 ${p.isSpeaking ? 'ring-inset ring-2 ring-blue-500/20' : ''}`}
                                >
                                    <span className={`${isMobile ? 'text-6xl' : 'text-8xl'} opacity-5 filter grayscale transition-transform group-hover:scale-105`}>{p.avatar}</span>

                                    {/* Etiqueta de Participante */}
                                    <div className={`absolute ${isMobile ? 'bottom-0 left-0 right-0 p-3' : 'bottom-4 left-4 p-2.5'} z-20 flex items-center justify-between ${isMobile ? 'bg-gradient-to-t from-black/80 to-transparent' : 'bg-black/60 backdrop-blur-md border border-white/5 shadow-xl'}`}>
                                        <span className="text-[10px] font-bold tracking-tight opacity-80 uppercase">{p.name}</span>
                                        {p.isSpeaking && (
                                            <div className="flex gap-0.5 items-end h-3">
                                                {[1, 2, 3].map(i => <div key={i} className="w-0.5 bg-blue-400" style={{ height: `${2 + (audioLevel * (i / 3))}px` }} />)}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}

                    {/* VÍDEO LOCAL (PIP) - Fixo para Mobile quando não há share */}
                    {isMobile && !isReceivingShare && (
                        <div className="absolute bottom-4 right-4 w-24 h-32 bg-[#111] border border-white/20 shadow-2xl z-40 overflow-hidden flex items-center justify-center">
                            {!isVideoOn ? (
                                <VideoOff size={18} className="text-white/10" />
                            ) : (
                                <div className="w-full h-full bg-[#0a0a0a] flex items-center justify-center relative">
                                    <span className="text-2xl opacity-10">👤</span>
                                    <div className="absolute bottom-1 inset-x-0 text-[8px] font-bold text-center opacity-30 uppercase">Você</div>
                                </div>
                            )}
                        </div>
                    )}
                </div>

                {/* SIDE PANEL (CHAT) - VISÍVEL APENAS NO DESKTOP */}
                <AnimatePresence>
                    {showSidePanel && !isMobile && (
                        <motion.aside
                            initial={{ x: 400 }} animate={{ x: 0 }} exit={{ x: 400 }}
                            className="w-96 bg-[#0a0a0c] border-l border-white/10 flex flex-col shadow-2xl z-[120]"
                        >
                            <div className="p-6 border-b border-white/10 flex justify-between items-center">
                                <h3 className="font-bold text-[10px] uppercase tracking-[0.2em] text-blue-500">Chat da Reunião</h3>
                                <button onClick={() => setShowSidePanel(false)} className="p-2 hover:bg-white/5 rounded-full transition-colors"><X size={18} /></button>
                            </div>
                            <div className="flex-1 p-6 overflow-y-auto space-y-4">
                                <div className="bg-zinc-900/40 p-4 border-l-2 border-blue-600 rounded-r-xl">
                                    <p className="text-[9px] font-bold text-white/40 uppercase mb-1">Bruno Costa • Agora</p>
                                    <p className="text-sm opacity-90 leading-relaxed">O layout híbrido está funcionando em qualquer tela!</p>
                                </div>
                            </div>
                            <div className="p-6 bg-black border-t border-white/5">
                                <div className="flex gap-2 bg-zinc-900/50 border border-white/10 rounded-2xl p-1.5 items-center pr-3 shadow-inner">
                                    <input placeholder="Enviar mensagem..." className="flex-1 bg-transparent px-4 py-2 text-sm outline-none placeholder:text-white/20" />
                                    <button className="bg-blue-600 p-2.5 rounded-xl shadow-lg hover:bg-blue-500 transition-colors"><ChevronUp size={20} className="rotate-90 text-white" /></button>
                                </div>
                            </div>
                        </motion.aside>
                    )}
                </AnimatePresence>
            </main>

            {/* 3. TOOLBAR (ESTILO CÁPSULA ARREDONDADA) */}
            <footer className={`${isMobile ? 'h-28' : 'h-24'} shrink-0 flex justify-center items-center bg-black border-t border-white/5`}>
                <div className={`flex items-center ${isMobile ? 'gap-1' : 'gap-2'} bg-zinc-900/90 backdrop-blur-3xl border border-white/10 p-2.5 rounded-full shadow-[0_25px_60px_rgba(0,0,0,0.8)]`}>

                    {/* MEDIA CONTROLS */}
                    <div className="flex items-center gap-1.5 px-2 border-r border-white/10">
                        <button onClick={() => setIsMuted(!isMuted)} className={`w-11 h-11 flex items-center justify-center rounded-full transition-all active:scale-90 ${isMuted ? 'bg-red-500/20 text-red-500 border border-red-500/20' : 'bg-white/5 text-white hover:bg-white/10'}`}>
                            {isMuted ? <MicOff size={20} /> : <Mic size={20} />}
                        </button>
                        <button onClick={() => setIsVideoOn(!isVideoOn)} className={`w-11 h-11 flex items-center justify-center rounded-full transition-all active:scale-90 ${!isVideoOn ? 'bg-red-500/20 text-red-500 border border-red-500/20' : 'bg-white/5 text-white hover:bg-white/10'}`}>
                            {!isVideoOn ? <VideoOff size={20} /> : <Video size={20} />}
                        </button>
                    </div>

                    {/* INTERACTION CONTROLS */}
                    <div className={`flex items-center ${isMobile ? 'gap-1' : 'gap-1.5'} px-2`}>
                        <button onClick={() => setIsReceivingShare(!isReceivingShare)} className={`w-11 h-11 flex items-center justify-center rounded-full transition-all ${isReceivingShare ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'bg-white/5 text-white hover:bg-white/10'}`}>
                            <Monitor size={20} />
                        </button>
                        <button
                            onClick={() => { if (isMobile) setShowChat(true); else setShowSidePanel(!showSidePanel); }}
                            className={`w-11 h-11 flex items-center justify-center rounded-full transition-all ${(!isMobile && showSidePanel) ? 'bg-white/20' : 'bg-white/5'} text-white hover:bg-white/10`}
                        >
                            <MessageSquare size={20} />
                        </button>
                        <button onClick={() => setHandRaised(!handRaised)} className={`w-11 h-11 flex items-center justify-center rounded-full transition-all ${handRaised ? 'bg-yellow-500 text-black shadow-lg shadow-yellow-500/30' : 'bg-white/5 text-white hover:bg-white/10'}`}>
                            <Hand size={20} fill={handRaised ? "currentColor" : "none"} />
                        </button>
                        {!isMobile && (
                            <button className="w-11 h-11 flex items-center justify-center rounded-full bg-white/5 text-white hover:bg-white/10"><UserPlus size={20} /></button>
                        )}
                        <button className="w-11 h-11 flex items-center justify-center rounded-full bg-white/5 text-white hover:bg-white/10"><Settings size={20} /></button>
                    </div>

                    <div className="w-px h-8 bg-white/10 mx-1.5" />

                    {/* HANG UP BUTTON */}
                    <button className={`flex items-center justify-center rounded-full bg-red-600 text-white shadow-xl hover:bg-red-500 active:scale-95 transition-all ${isMobile ? 'w-11 h-11' : 'px-6 h-11 gap-3'}`}>
                        <PhoneOff size={20} fill="currentColor" />
                        {!isMobile && <span className="font-bold text-xs tracking-tighter uppercase">Encerrar</span>}
                    </button>
                </div>
            </footer>

            {/* CHAT MODAL (MOBILE APENAS) */}
            <AnimatePresence>
                {isMobile && showChat && (
                    <>
                        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} onClick={() => setShowChat(false)} className="absolute inset-0 bg-black/80 z-[120] backdrop-blur-md" />
                        <motion.div initial={{ y: "100%" }} animate={{ y: 0 }} exit={{ y: "100%" }} transition={{ type: "spring", damping: 25, stiffness: 200 }} className="absolute bottom-0 inset-x-0 h-[75%] bg-[#0f1115] z-[130] rounded-t-[40px] border-t border-white/10 flex flex-col shadow-2xl">
                            <div className="w-12 h-1.5 bg-white/10 rounded-full mx-auto mt-4 mb-6" />
                            <div className="px-8 flex justify-between items-center mb-4">
                                <h3 className="font-bold text-lg">Mensagens</h3>
                                <button onClick={() => setShowChat(false)} className="p-2 bg-white/5 rounded-full"><X size={20} /></button>
                            </div>
                            <div className="flex-1 px-8 py-4 overflow-y-auto">
                                <div className="bg-zinc-900/60 p-4 rounded-2xl rounded-tl-none border border-white/5 max-w-[85%]">
                                    <p className="text-[10px] text-blue-400 font-bold mb-1 uppercase tracking-widest">Bruno Costa</p>
                                    <p className="text-sm opacity-90 leading-relaxed">Versão Mobile funcionando perfeitamente com layout fixo!</p>
                                </div>
                            </div>
                            <div className="p-6 pb-12 bg-black/60">
                                <div className="flex gap-3 p-1.5 bg-zinc-900 border border-white/10 rounded-2xl items-center pr-3 shadow-inner">
                                    <input placeholder="Digite aqui..." className="flex-1 bg-transparent px-4 py-2 text-sm outline-none text-white placeholder:text-white/20" />
                                    <button className="bg-blue-600 p-2.5 rounded-xl text-white shadow-lg shadow-blue-600/30"><ChevronUp size={20} className="rotate-90" /></button>
                                </div>
                            </div>
                        </motion.div>
                    </>
                )}
            </AnimatePresence>

            <div className="absolute bottom-2 left-1/2 -translate-x-1/2 w-32 h-1 bg-white/10 rounded-full z-[150] pointer-events-none" />

            <style>{`
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
      `}</style>
        </div>
    );
};

export default App;